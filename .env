# Forgejo Auto-Snapshot Dashboard Environment Variables

# Base URL for the Forgejo instance.
# Example: FORGEJO_URL=https://forgejo.iticareer.com/
FORGEJO_URL=

# Default interval in seconds for automatic snapshots.
# Must be between 5 and 300.
# Example: DEFAULT_SNAPSHOT_INTERVAL_SECONDS=15
# DEFAULT_SNAPSHOT_INTERVAL_SECONDS=

# Minimum allowed snapshot interval in seconds.
# Example: MIN_SNAPSHOT_INTERVAL_SECONDS=5
# MIN_SNAPSHOT_INTERVAL_SECONDS=

# Maximum allowed snapshot interval in seconds.
# Example: MAX_SNAPSHOT_INTERVAL_SECONDS=300
# MAX_SNAPSHOT_INTERVAL_SECONDS=

# List of default glob patterns to ignore in projects, comma-separated.
# Example: DEFAULT_IGNORES=node_modules,dist,build,.venv,__pycache__
# DEFAULT_IGNORES=

# Default Git branch name for new projects.
# Example: DEFAULT_BRANCH=main
# DEFAULT_BRANCH=

# Recommended branch name for auto-snapshots.
# Example: AUTOSNAP_BRANCH_NAME=autosnap
# AUTOSNAP_BRANCH_NAME=

# Default push mode for snapshots.
# Allowed values: "Forgejo only", "No push", "Dual Remote"
# Example: DEFAULT_PUSH_MODE="Forgejo only"
# DEFAULT_PUSH_MODE=

# Logging level for the application.
# Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Example: LOG_LEVEL=INFO
# LOG_LEVEL=

# Path to the main application log file.
# Example: LOG_FILE=logs/app.log
# LOG_FILE=

# Path to the JSON file storing project configurations.
# Example: PROJECTS_DATA_FILE=data/projects.json
# PROJECTS_DATA_FILE=

# Path to the JSON file storing retention policies.
# Example: RETENTION_POLICY_FILE=data/retention/policy.json
# RETENTION_POLICY_FILE=

# Whether to enable the Windows startup task.
# Allowed values: true, false
# Example: ENABLE_STARTUP_TASK=false
# ENABLE_STARTUP_TASK=

# Whether to enable native Windows notifications.
# Allowed values: true, false
# Example: ENABLE_WINDOWS_NOTIFICATIONS=false
# ENABLE_WINDOWS_NOTIFICATIONS=

GEMINI_API_KEY="AIzaSyBYIwrHqvjzzDo0skNIeVR8CZpq11yxgSY"